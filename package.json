    "eslint": "^7.28.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-jsort": "^1.1.2",
    "expect.js": "^0.3.1",
    "mocha": "^9.0.0",
    "np": "^7.5.0",
    "nyc": "^15.1.0",
    "prettier": "2.3.1",
    "typescript": "^4.3.2"
  },
  "engines": {
    "node": ">=0.10.0"
